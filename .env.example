# Application
PORT=4000
MAX_LOG_SIZE=50

# Database
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_NAME=root
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@db:${DB_PORT}/${DB_NAME}?schema=public"

# Authorization
CRYPT_SALT=10
JWT_SECRET_KEY=secret123123
JWT_SECRET_REFRESH_KEY=secret123123
TOKEN_EXPIRE_TIME=1h
TOKEN_REFRESH_EXPIRE_TIME=24h
