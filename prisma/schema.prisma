generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String  @id @default(uuid())
  login      String  @unique
  password   String
  version    Int     @default(1)
  createdAt  BigInt? @default(dbgenerated("(EXTRACT(EPOCH FROM NOW()) * 1000)::bigint"))
  updatedAt  BigInt? @default(dbgenerated("(EXTRACT(EPOCH FROM NOW()) * 1000)::bigint"))
}
